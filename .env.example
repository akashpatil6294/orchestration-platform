# =============================================================================
# Workflow Orchestration Platform - environment template
# =============================================================================
#
# Copy this file to `.env` for the backend and to `frontend/.env.local` for the
# browser build, then fill in the values marked REQUIRED.
#
#   cp .env.example .env
#   cp .env.example frontend/.env.local        # or create it by hand, see below
#
# Never commit a filled-in `.env` or `frontend/.env.local`: both are git-ignored.
#
# Labels used below
#   PUBLIC   - safe to ship to the browser; ends up in the JavaScript bundle
#   PRIVATE  - server-side only; must never appear in the browser bundle
#   REQUIRED - the application refuses to work correctly without it
#   OPTIONAL - has a working default; set it only when you need to change it
#
# Supabase is used for one thing only: authentication (Google sign-in). Your
# users, workflows, versions, runs, steps, attempts, events, schedules, workers
# and leases all live in the database configured by DATABASE_URL.
# =============================================================================


# -----------------------------------------------------------------------------
# BACKEND  (read by app/config.py; copy to ./.env)
# -----------------------------------------------------------------------------

# PRIVATE / OPTIONAL - "development" locally. "production" or "staging" makes the
# application refuse to boot with default development secrets.
ENVIRONMENT=development

# PRIVATE / OPTIONAL - how this API is reached from a browser. Used in generated
# links and documented examples.
PUBLIC_BASE_URL=http://127.0.0.1:8000

# PRIVATE / REQUIRED - the durable store for everything the platform owns.
# PostgreSQL for anything shared; SQLite is fine for zero-setup local work.
#
#   PostgreSQL: DATABASE_URL=postgresql+psycopg2://user:password@host:5432/orchestrator
#   SQLite:     DATABASE_URL=sqlite:///./orchestrator.db
#
# Point this at your own database. It is NOT the Supabase client API and no
# Supabase service-role key is used to reach it.
DATABASE_URL=postgresql+psycopg2://postgres:CHANGE_ME@db.example.supabase.co:5432/postgres

# PRIVATE / REQUIRED IN PRODUCTION - signs this application's own session tokens.
# In production it must be a random value of at least 32 characters. Generate:
#   python -m app.cli gen-secret
SECRET_KEY=change-me-to-a-random-string-of-at-least-32-characters

# PRIVATE / REQUIRED IN PRODUCTION - peppers the hashes of worker and API tokens,
# so a stolen database dump alone cannot be replayed. At least 16 characters.
WORKER_SECRET_PEPPER=change-me-to-a-random-string-of-at-least-16-chars

# PRIVATE / REQUIRED IN PRODUCTION - encrypts workflow secret values at rest.
# Generate: python -m app.cli gen-secret
SECRETS_ENCRYPTION_KEY=

# PRIVATE / OPTIONAL - comma-separated browser origins allowed to call the API.
# Must list the frontend origin(s); "*" is never used for authenticated APIs.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PRIVATE / OPTIONAL - Supabase project URL. Setting it enables Google sign-in.
# Leave empty and only email+password sign-in is offered.
SUPABASE_URL=https://fdbhmmnucqbdayernurg.supabase.co

# PRIVATE / OPTIONAL - only needed when your Supabase project still signs session
# tokens with the legacy shared secret (HS256). New projects sign with
# asymmetric keys (ES256) and are verified through the project's public JWKS,
# so leave this empty in that case. Find it under
# Supabase -> Project Settings -> API -> JWT Settings.
# This is a server-side secret: never put it in a VITE_ variable.
SUPABASE_JWT_SECRET=

# PRIVATE / OPTIONAL - audience expected in Supabase session tokens.
SUPABASE_JWT_AUDIENCE=authenticated

# PRIVATE / OPTIONAL - override the public key set location. Leave empty to use
# <SUPABASE_URL>/auth/v1/.well-known/jwks.json.
SUPABASE_JWKS_URL=

# PRIVATE / OPTIONAL - how long the downloaded Supabase public keys are cached.
SUPABASE_JWKS_CACHE_SECONDS=3600

# PRIVATE / OPTIONAL - set to false to disable email+password sign-in entirely
# and accept Google sign-in only.
PASSWORD_AUTH_ENABLED=true

# PRIVATE / OPTIONAL - provider used by ai.summarize and ai.classify.
# Groq is the default. Keep credentials server-side; never use a VITE_ prefix.
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# Gemini remains available with AI_PROVIDER=gemini.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
MAX_AI_TEXT_CHARS=80000
MAX_DOCUMENT_BYTES=5242880

# PRIVATE / OPTIONAL - worker connectors. HTTP is SSRF-guarded (private ranges,
# loopback, link-local and cloud metadata are blocked; every redirect hop is
# re-validated against DNS). The optional domain allow-list restricts outbound
# HTTP to those hosts and their subdomains.
CONNECTOR_HTTP_ALLOWED_DOMAINS=
CONNECTOR_HTTP_TIMEOUT_SECONDS=30
CONNECTOR_HTTP_MAX_REDIRECTS=3
CONNECTOR_HTTP_MAX_RESPONSE_BYTES=5242880
CONNECTOR_BLOCKED_NETWORKS=
CONNECTOR_ALLOW_PRIVATE_NETWORKS=false

# PRIVATE / OPTIONAL - sql.query connector. Statements are parameterized and
# read-only (SELECT/WITH/EXPLAIN/SHOW/VALUES) unless this admin flag is set.
# The connection URL always comes from a workflow secret.
CONNECTOR_SQL_TIMEOUT_SECONDS=30
CONNECTOR_SQL_MAX_ROWS=1000
CONNECTOR_SQL_ALLOW_WRITES=false

# PRIVATE / OPTIONAL - when true, the email/slack/webhook connectors validate
# their input and log what they would send without touching the network.
# Intended for tests and staging; leave false in production.
CONNECTORS_DRY_RUN=false

# PRIVATE / OPTIONAL - outbound SMTP for the email.send connector. SMTP_FROM is
# required when SMTP_HOST is configured.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=15

# PRIVATE / OPTIONAL - first account bootstrap, useful for scripted deployments.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=

# PRIVATE / OPTIONAL - execution tuning.
LEASE_SECONDS=30
WORKER_HEARTBEAT_INTERVAL=10
WORKER_STALE_SECONDS=120
DISPATCH_BATCH_SIZE=50
MAX_WORKFLOW_STEPS=100
MAX_STEPS_PER_RUN=200
MAX_SUBWORKFLOW_DEPTH=8
RETRY_MAX_DELAY_SECONDS=3600
RETRY_JITTER=0.25
MAX_GLOBAL_RUNNING_TASKS=0
MAX_RUNNING_TASKS_PER_OWNER=0
# JSON maps: {"gpu": 8} and {"http.request": 120}. Zero global/owner cap disables it.
QUEUE_CONCURRENCY_LIMITS={}
TASK_RATE_LIMITS={}
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=60
POISON_TASK_EXPIRY_LIMIT=3
MAX_REQUEST_BYTES=52428800
MAX_TASK_OUTPUT_BYTES=52428800
MAX_INLINE_OUTPUT_BYTES=1048576

# PRIVATE / OPTIONAL - large task results are written outside the database and
# represented in step output by an authenticated artifact URI. Local disk is
# the default. Keep ARTIFACT_DIR on durable shared storage for multi-host use.
ARTIFACT_STORAGE=local
ARTIFACT_DIR=./artifacts
# For S3-compatible storage set ARTIFACT_STORAGE=s3 and the bucket. Credentials
# stay server-side; the endpoint and access key fields are never sent to clients.
ARTIFACT_S3_BUCKET=
ARTIFACT_S3_ENDPOINT_URL=
ARTIFACT_S3_REGION=us-east-1
ARTIFACT_S3_ACCESS_KEY_ID=
ARTIFACT_S3_SECRET_ACCESS_KEY=

# PRIVATE / OPTIONAL - recurring schedules.
SCHEDULER_ENABLED=true
SCHEDULER_INTERVAL_SECONDS=15
SCHEDULER_BATCH_SIZE=25
WEBHOOK_MAX_CLOCK_SKEW_SECONDS=300
TRIGGER_DEFAULT_RATE_LIMIT_PER_MINUTE=60

# PRIVATE / OPTIONAL - Redis is only used to fan out task dispatch. Leave empty
# to let workers poll the database directly (nothing else changes).
REDIS_URL=

# PRIVATE / OPTIONAL - logging and metrics.
LOG_LEVEL=INFO
LOG_FORMAT=console
METRICS_ENABLED=true
SQL_ECHO=false

# PRIVATE / OPTIONAL - default dashboard aggregation window in hours (1-720).
# The dashboard UI can still pick 1h / 24h / 7d / 30d per visit.
DEFAULT_DASHBOARD_WINDOW_HOURS=24

# PRIVATE / OPTIONAL - worker client defaults, read by `python -m app.sample_worker`.
ORCHESTRATOR_API=http://127.0.0.1:8000
WORKER_ID=sample-worker-1
WORKER_TOKEN=
WORKER_TASK_TYPES=
WORKER_POLL_SECONDS=1.0
WORKER_LONG_POLL_SECONDS=20
WORKER_QUEUES=default
WORKER_MAX_CONCURRENCY=4

# Embedded worker: runs inside the API process so `python -m app.cli dev` needs
# no separate worker terminal. Blank (default) = on when ENVIRONMENT is
# development/local, off otherwise. Queues is a comma-separated list.
#EMBEDDED_WORKER_ENABLED=
EMBEDDED_WORKER_CONCURRENCY=4
EMBEDDED_WORKER_QUEUES=default
# Seconds a ready step may wait before the UI warns that no worker covers it.
QUEUE_WAIT_WARNING_SECONDS=30


# -----------------------------------------------------------------------------
# FRONTEND  (read by Vite; copy to ./frontend/.env.local)
#
# Only PUBLIC values belong here. Everything in this file is compiled into the
# JavaScript the browser downloads, so treat it as world-readable.
# -----------------------------------------------------------------------------

# PUBLIC / REQUIRED - Supabase project URL. Must match the backend SUPABASE_URL.
VITE_SUPABASE_URL=https://fdbhmmnucqbdayernurg.supabase.co

# PUBLIC / REQUIRED - the publishable (a.k.a. anon) key from
# Supabase -> Project Settings -> API. Safe in a browser: it only grants what
# your row-level security policies allow, and this platform never uses Supabase
# to store data.
#   NEVER put the service_role key here.
#   NEVER put the Google OAuth client secret here.
VITE_SUPABASE_ANON_KEY=your-publishable-anon-key

# PUBLIC / OPTIONAL - where the FastAPI backend is reachable from the browser.
VITE_API_BASE_URL=http://127.0.0.1:8000

# -----------------------------------------------------------------------------
# PRODUCTION ONLY (uncomment and fill in for ENVIRONMENT=production)
# -----------------------------------------------------------------------------
# The app refuses to boot in production with dev defaults. Generate secrets:
#   python -m app.cli gen-secret   (run 3x, use for the three values below)
# Rotate AI keys if they were ever pasted anywhere:
#   GROQ:   https://console.groq.com/keys
#   Gemini: https://aistudio.google.com/app/apikey

# ENVIRONMENT=production
# SECRET_KEY=<64-char-random>
# WORKER_SECRET_PEPPER=<32-char-random>
# SECRETS_ENCRYPTION_KEY=<32-char-random>
# DATABASE_URL=postgresql+psycopg2://orchestrator:<password>@localhost:5432/orchestrator
# CORS_ORIGINS=https://app.<your-domain>
# GROQ_API_KEY=<rotated-key>        # or GEMINI_API_KEY, per AI_PROVIDER
# EMBEDDED_WORKER_ENABLED=false
# Run workers separately: python scripts/run_worker.py (repeatable)
#
# Operations (see SETUP_NOTES.md):
# LOG_FORMAT=json                   # JSON logs for aggregation
# API_RATE_LIMIT_PER_MINUTE=600     # per-IP API limit (0 = off)
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# Or Docker-secrets style: SECRET_KEY_FILE=/run/secrets/secret_key, etc.
# (SECRET_KEY, WORKER_SECRET_PEPPER, SECRETS_ENCRYPTION_KEY, GROQ_API_KEY,
#  GEMINI_API_KEY, DATABASE_URL all support _FILE variants)
