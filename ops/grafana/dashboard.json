{"panels":[{"targets":[{"expr":"sum by (status) (rate(orchestrator_runs_settled_total[5m]))","legendFormat":"{{status}}"}],"title":"Runs settled","type":"timeseries"},{"targets":[{"expr":"orchestrator_queue_depth","legendFormat":"{{queue}}"}],"title":"Queue depth by queue","type":"timeseries"},{"targets":[{"expr":"orchestrator_workers_active"}],"title":"Active workers","type":"stat"},{"targets":[{"expr":"histogram_quantile(0.95, sum by (le, queue) (rate(orchestrator_claim_seconds_bucket[5m])))","legendFormat":"{{queue}}"}],"title":"Claim latency p95","type":"timeseries"},{"targets":[{"expr":"histogram_quantile(0.95, sum by (le, task_type) (rate(orchestrator_step_duration_seconds_bucket[5m])))","legendFormat":"{{task_type}}"}],"title":"Step duration p95 by task type","type":"timeseries"},{"targets":[{"expr":"orchestrator_dlq_size"}],"title":"DLQ size","type":"stat"},{"targets":[{"expr":"orchestrator_outbox_backlog"}],"title":"Outbox backlog","type":"stat"},{"targets":[{"expr":"sum(rate(orchestrator_lease_expirations_total[5m]))"}],"title":"Lease expirations","type":"timeseries"},{"targets":[{"expr":"sum by (status) (rate(orchestrator_notification_deliveries_total[5m]))","legendFormat":"{{status}}"}],"title":"Notification deliveries","type":"timeseries"},{"targets":[{"expr":"topk(10, sum by (owner_id) (rate(orchestrator_tenant_runs_created_total[5m])))","legendFormat":"{{owner_id}}"}],"title":"Runs created by tenant (top 10)","type":"timeseries"}],"schemaVersion":39,"timezone":"browser","title":"Orchestration Platform","uid":"orchestrator-overview"}