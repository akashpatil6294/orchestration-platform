# -----------------------------------------------------------------------------
# Frontend environment (copy to frontend/.env.local)
#
# Vite only exposes variables prefixed with VITE_, and everything it exposes is
# compiled into the JavaScript the browser downloads. Treat this file as
# world-readable: put nothing here that you would not publish.
#
# Never place any of these here:
#   - the Google OAuth client secret      (belongs only in the Google console)
#   - the Supabase service_role key
#   - the database password or DATABASE_URL
#   - SECRET_KEY, WORKER_SECRET_PEPPER or any worker token
# -----------------------------------------------------------------------------

# PUBLIC / REQUIRED - Supabase project URL. Must match SUPABASE_URL on the backend.
VITE_SUPABASE_URL=https://fdbhmmnucqbdayernurg.supabase.co

# PUBLIC / REQUIRED - publishable (anon) key.
# Supabase dashboard -> Project Settings -> API -> Project API keys -> anon/public
VITE_SUPABASE_ANON_KEY=replace-with-your-publishable-anon-key

# PUBLIC / OPTIONAL - location of the FastAPI backend.
VITE_API_BASE_URL=http://127.0.0.1:8000
