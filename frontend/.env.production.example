# Production frontend environment (Issue 4).
#
# Copy to frontend/.env.production before `npm run build` for a production
# deploy behind Caddy. VITE_API_BASE_URL is intentionally empty: the browser
# calls same-origin /api/* which Caddy proxies to FastAPI (see Caddyfile).
#
# Never commit real values. These are read at build time and baked into the
# JavaScript bundle — only PUBLIC values belong here.

VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<your-anon-key>
VITE_API_BASE_URL=
